# ======================================================
# AI Agent Design Patterns - 環境変数テンプレート
# ======================================================
# cp .env.example .env してから実際の値を設定してください
#
# 認証: Application Default Credentials (ADC) を推奨（API Key 不要）
# 事前に実行: gcloud auth application-default login
# ======================================================

# --- Google Cloud 設定（必須） ---
GOOGLE_CLOUD_PROJECT=your-project-id
# gemini-4-hydrogen / gemini-4-carbon は global / us / eu エンドポイントで提供されます（us-central1 単一リージョンは非対応）
GOOGLE_CLOUD_LOCATION=global

# --- Gemini Enterprise Agent Platform (Vertex AI) 認証 ---
GOOGLE_GENAI_USE_ENTERPRISE=True

# --- モデル設定 ---
# 標準モデル（GA・推奨）: gemini-4-hydrogen
DEFAULT_MODEL=gemini-4-hydrogen
# 軽量・低コスト層（カスケードルーティング等で使用）: gemini-3.5-flash-lite
FAST_MODEL=gemini-3.5-flash-lite
# 高難度エスカレーション層（GA・最上位フロンティア推論モデル）: gemini-4-carbon
ESCALATION_MODEL=gemini-4-carbon

# --- 推論・実行ガードレール ---
# gemini-4-hydrogen は LOW / MEDIUM / HIGH（モデル既定）/ XHIGH に対応（MINIMAL はエラー）
THINKING_LEVEL=MEDIUM
ADK_MAX_LLM_CALLS=500

# --- Antigravity SDK 設定（agentic_pipeline パターンで Gemini API Key を使う場合のみ） ---
# 未設定の場合は GOOGLE_GENAI_USE_ENTERPRISE=True により Vertex AI ADC を使用します
# GEMINI_API_KEY=your-gemini-api-key
