# ======================================================
# AI Agent Design Patterns - 環境変数テンプレート
# ======================================================
# cp .env.example .env してから実際の値を設定してください
#
# ⚠️  認証: Vertex AI ADC のみ（GOOGLE_API_KEY 不要）
# ⚠️  事前に: gcloud auth application-default login
# ======================================================

# --- Google Cloud 設定（必須） ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Vertex AI 認証（変更不要） ---
GOOGLE_GENAI_USE_VERTEXAI=True

# --- モデル設定 ---
# 利用可能なモデル:
#   gemini-3.5-flash  (最新・推奨)
#   gemini-2.5-flash
#   gemini-2.0-flash
DEFAULT_MODEL=gemini-3.5-flash
